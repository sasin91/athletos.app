# AthletOS configuration.
#
# Two audiences, one file. In development, copy this to `.env` at the repository
# root and `dotenvy` reads it when you `cargo run --bin api`. In production it
# is `/usr/local/etc/athletos/env` on the box, 0600, root-owned, nullfs-mounted
# read-only into both jails, and sourced by the rc scripts with `set -a`. The
# format is the same in both places on purpose: plain KEY=value, no `export`,
# no shell substitution.
#
# The signing key is deliberately not in here. See AUTH_SIGNING_KEY_PEM below.

# ---------------------------------------------------------------------------
# Where this deployment lives
# ---------------------------------------------------------------------------

# The public hostname. Caddy serves the app on this name and the API on
# `api.` + this name; both need A and AAAA records pointing at the box.
APP_DOMAIN=athletos.example

# Where Let's Encrypt sends expiry warnings that will never arrive, because
# Caddy renews on its own. Still worth being real: it is also where problems
# with the account are sent.
ACME_EMAIL=ops@athletos.example

# SvelteKit compares the Origin header of every form POST against this and
# rejects mismatches. Not optional: form actions fail closed without it.
# Development: http://localhost:5173
ORIGIN=https://athletos.example

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Production is a unix socket and nothing else — Postgres is configured with
# `listen_addresses = ''`, so the database is unreachable over the network
# regardless of what any firewall says. `?host=` is how sqlx is told to use a
# socket directory rather than TCP.
DATABASE_URL=postgres://athletos@localhost/athletos?host=/var/run/postgresql
# Development, against the WSLC container in docs/DEVELOPMENT.md:
# DATABASE_URL=postgres://postgres:athletos@127.0.0.1:5432/athletos

# Two jails, so two pools. Ten each against Postgres's default 100 leaves plenty
# of room for a psql session and a pg_dump during a deploy.
DATABASE_MAX_CONNECTIONS=10

# The rc script overrides this with the jail's own value; it is here so that a
# `cargo run` has a default.
BIND_ADDR=0.0.0.0:8080

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

# `production` is a lock, not a label: it makes AUTH_ALLOW_EPHEMERAL_SIGNING_KEY
# a startup error rather than a warning. Leave it unset in development.
APP_ENV=production

RUST_LOG=info,tower_http=warn

# ---------------------------------------------------------------------------
# Signing keys
# ---------------------------------------------------------------------------
#
# AUTH_SIGNING_KEY_PEM is NOT set in this file in production. The rc scripts
# read the PEM from /usr/local/etc/athletos/signing-key.pem — root-owned, 0400 —
# and export it into the process environment before daemon(8) drops privileges,
# so the service account never has permission to read the key it signs with.
#
# Generate it, once, and never rotate it casually — every outstanding access
# token is signed by it:
#
#     openssl genpkey -algorithm ED25519 -out /usr/local/etc/athletos/signing-key.pem
#     chmod 0400 /usr/local/etc/athletos/signing-key.pem
#
# If a deployment target insists on the key being an environment variable, the
# single-line form with literal \n escapes is what survives env tooling that
# round-trips values, and the code un-escapes it:
#
#     sed 's/$/\\n/' signing-key.pem | tr -d '\n'
#
# AUTH_SIGNING_KEY_PEM=
AUTH_SIGNING_KEY_ID=athletos-2026-07

# Retired public keys that must still verify tokens signed before a rotation,
# as a comma-separated list of `kid:base64url-32-bytes`. A rotation is: mint a
# new key, publish it as the signer, move the old public key here, and delete it
# once every access token it signed has expired — that is
# AUTH_ACCESS_TOKEN_TTL_SECONDS later, not AUTH_REFRESH_TOKEN_TTL_SECONDS.
AUTH_ADDITIONAL_VERIFICATION_KEYS=

# Two independent mistakes rather than one. Setting this to `true` generates a
# throwaway keypair at startup, which invalidates every token on every restart
# and cannot be verified by the other jail. It is refused outright when
# APP_ENV=production, and that refusal is the reason it is safe to leave the
# variable in this file at all.
AUTH_ALLOW_EPHEMERAL_SIGNING_KEY=false

AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

AUTH_ISSUER=athletos-api
AUTH_AUDIENCE=athletos

# The bundled breach corpus is checked either way. This adds a k-anonymity range
# lookup against Have I Been Pwned on top of it — an outbound request to a third
# party every time a password is chosen. Off by default, and turning it on in a
# jail means that jail needs working DNS and outbound HTTPS through the NAT rule
# in /etc/pf.conf.
AUTH_HIBP_ENABLED=false
AUTH_HIBP_TIMEOUT_MS=2000

# ---------------------------------------------------------------------------
# Web (SvelteKit / adapter-node)
# ---------------------------------------------------------------------------
#
# HOST, PORT and API_BASE_URL are set per jail by the rc script from that jail's
# /etc/rc.conf, so they are not listed here. They are read at request time
# rather than build time, which is what lets one built bundle be pointed at a
# staging API without rebuilding.
#
# Uncomment for a local `node build`:
# API_BASE_URL=http://127.0.0.1:8080
# PORT=3000
# HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Releases
# ---------------------------------------------------------------------------

# Where `athletos-deploy <tag>` pulls artifacts from. In the env file rather
# than baked into the script, so a fork or a staging box needs no edit to a
# root-owned 0555 script.
GITHUB_REPO=owner/athletos

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------

# A Hetzner Storage Box. SSH key auth only; the key is /root/.ssh/id_ed25519_backup
# by default and its public half goes in the Storage Box's authorized_keys.
BACKUP_SSH_TARGET=u123456@u123456.your-storagebox.de
BACKUP_REMOTE_DIR=athletos
BACKUP_SSH_KEY=/root/.ssh/id_ed25519_backup

# The age PUBLIC key. Only the public half is ever on this machine, so a box
# that is compromised cannot read its own backup history. Generate the pair
# somewhere that is not this box:
#
#     age-keygen -o athletos-backup.key      # keep this off the server
#     grep 'public key' athletos-backup.key  # the value below
#
# Losing the private key means losing every backup. Losing it is a more likely
# way to lose this data than losing the server is.
BACKUP_AGE_RECIPIENT=age1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqsxxxxxx
